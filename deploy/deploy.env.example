# FujiHub deploy configuration.
# Copy this file to deploy.env on the server and adjust values.

# Repositories on the server.
API_DIR=/var/www/fujihub-api
WEB_DIR=/var/www/fujihub-web

# Expected production branches.
# Use master or main according to the real branch on each repository.
BACKEND_BRANCH=master
WEB_BRANCH=master

# Services.
# Leave BACKEND_SERVICE empty when Django runs only through Apache/mod_wsgi.
BACKEND_SERVICE=
# Use apache2 for Apache or nginx for Nginx.
WEB_SERVER_SERVICE=apache2

# Build/runtime paths.
WEB_BUILD_DIR=dist
WEB_PUBLISH_DIR=/var/www/fujihub-web/dist
VENV_DIR=/var/www/fujihub-api/venv

# force mode behavior:
# stash = preserve local changes in git stash before pull
# reset = discard local changes with git reset --hard and git clean -fd
FORCE_STRATEGY=stash

# Required for web build in production.
# Example: VITE_API_URL=https://api.emilioeiji.com.br
VITE_API_URL=https://api.emilioeiji.com.br

# Optional HTTP health checks.
# For Django token endpoint /api/token/ GET/HEAD may return 405.
# Keep BACKEND_HEALTH_URL empty unless you have a dedicated GET health endpoint.
BACKEND_HEALTH_URL=
WEB_HEALTH_URL=https://hub.emilioeiji.com.br/

# Optional tuning.
BACKEND_LOG_LINES=80
RUN_COLLECTSTATIC=true
USE_NPM_CI=true
