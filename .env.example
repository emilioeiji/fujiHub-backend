DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=fuji_backend.settings.dev

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_DIST_DIR=/workspace/web/dist
FRONTEND_ASSETS_DIR=/workspace/web/dist/assets

DATABASE_ENGINE=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=django
MYSQL_USER=django
MYSQL_PASSWORD=django
MYSQL_ROOT_PASSWORD=root
ALLOW_DEV_TO_USE_PROD_DB=false

# Produção (exemplo; não use estes valores no ambiente local)
# DJANGO_DEBUG=False
# DJANGO_SETTINGS_MODULE=fuji_backend.settings.prod
# DJANGO_ALLOWED_HOSTS=hub.emilioeiji.com.br,api.emilioeiji.com.br
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://hub.emilioeiji.com.br
# CSRF_TRUSTED_ORIGINS=https://hub.emilioeiji.com.br
# WEB_DIST_DIR=/var/www/fujihub-web/dist
# FRONTEND_ASSETS_DIR=/var/www/fujihub-web/dist/assets
